* { box-sizing: border-box; }
html, body, #root { margin: 0; min-height: 100%; height: 100%; font-family: Inter, Arial, sans-serif; background: #f3f6f8; }
body { color: #14252d; }
button, input, textarea, select { font: inherit; }
button { cursor: pointer; }

.auth-shell {
  min-height: 100vh;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, #dffaf2, #eef6fb, #f6f1ff);
  padding: 24px;
}

.auth-card {
  width: min(440px, 100%);
  background: rgba(255,255,255,0.9);
  border: 1px solid #dfe9ee;
  backdrop-filter: blur(10px);
  border-radius: 22px;
  box-shadow: 0 24px 60px rgba(18, 38, 46, 0.1);
  padding: 30px 26px 22px;
}

.brand-block {
  text-align: center;
  margin-bottom: 18px;
}

.brand-logo {
  display: inline-grid;
  place-items: center;
  width: 52px;
  height: 52px;
  border-radius: 16px;
  background: linear-gradient(135deg, #10b981, #0c7b6a);
  color: white;
  font-weight: 700;
  font-size: 1.2rem;
}

.brand-block h1 {
  margin: 16px 0 6px;
  font-size: 2rem;
  letter-spacing: -0.04em;
}

.brand-block p {
  margin: 0;
  color: #5b7076;
}

.auth-form {
  display: grid;
  gap: 14px;
}

.auth-form label, .repo-form label {
  display: grid;
  gap: 7px;
  font-size: 0.86rem;
  color: #324b55;
  font-weight: 600;
}

.auth-form input, .auth-form textarea, .auth-form select,
.repo-form input, .repo-form textarea, .repo-form select,
.message-form input, .searchbox input {
  width: 100%;
  border: 1px solid #d9e4e8;
  border-radius: 10px;
  padding: 11px 12px;
  background: white;
  color: #16313d;
  outline: none;
}

.auth-form input:focus, .repo-form input:focus, .repo-form textarea:focus, .message-form input:focus, .searchbox input:focus {
  border-color: #13b48d;
  box-shadow: 0 0 0 3px rgba(19, 180, 141, 0.12);
}

.tab-toggle {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  background: #f1f5f7;
  padding: 4px;
  border-radius: 12px;
  margin-bottom: 6px;
}

.tab-toggle button {
  padding: 10px 12px;
  border: 0;
  background: transparent;
  border-radius: 10px;
  color: #445d68;
  font-weight: 700;
}

.tab-toggle button.active {
  background: white;
  color: #0c7b6a;
  box-shadow: 0 4px 12px rgba(12, 123, 106, 0.12);
}

.primary-btn, .secondary-btn, .new-repo-btn, .top-btn, .logout-btn {
  border: none;
  border-radius: 10px;
  padding: 10px 14px;
  font-weight: 700;
}

.primary-btn {
  background: linear-gradient(135deg, #13b48d, #0b8b76);
  color: white;
  margin-top: 8px;
}

.secondary-btn {
  background: #edf3f6;
  color: #294a58;
}

.message {
  margin: 0;
  font-size: 0.85rem;
  padding: 8px 10px;
  border-radius: 8px;
}

.message.success {
  background: #eafaf4;
  color: #0d6d59;
}

.message.error {
  background: #fff0ee;
  color: #b34732;
}

.dashboard-shell {
  display: flex;
  min-height: 100vh;
  background: #edf3f5;
}

.sidebar {
  width: 270px;
  background: #11272f;
  color: #ecf4f5;
  padding: 18px 16px;
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 8px 6px 14px;
  border-bottom: 1px solid rgba(255,255,255,0.08);
}

.brand-row strong {
  display: block;
  font-size: 1.03rem;
}

.brand-row small {
  color: #90abb2;
}

.brand-row .brand-logo {
  width: 40px;
  height: 40px;
  border-radius: 12px;
  font-size: 0.9rem;
}

.sidebar-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}

.label {
  font-size: 0.7rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #90abb2;
  margin: 0;
}

.new-repo-btn {
  background: #17343b;
  color: #ecf5f5;
  padding: 8px 10px;
}

.repo-list {
  display: grid;
  gap: 8px;
  margin-top: 4px;
}

.repo-item {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  background: transparent;
  border: none;
  color: #d7e3e5;
  border-radius: 10px;
  text-align: left;
  padding: 9px 10px;
  font-weight: 600;
}

.repo-item.active {
  background: #1b3b44;
}

.dot {
  width: 9px;
  height: 9px;
  border-radius: 999px;
  display: inline-block;
}

.user-box {
  margin-top: auto;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 14px;
  padding: 12px 10px;
  display: flex;
  align-items: center;
  gap: 10px;
}

.user-box strong, .user-box small {
  display: block;
}

.user-box small {
  color: #9ab2b9;
  margin-top: 2px;
}

.avatar-circle {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: linear-gradient(135deg, #14b8a6, #0e7d70);
  color: white;
  display: grid;
  place-items: center;
  font-size: 0.72rem;
  font-weight: 700;
}

.avatar-circle.small {
  width: 28px;
  height: 28px;
  font-size: 0.63rem;
}

.avatar-circle.alt {
  background: linear-gradient(135deg, #8b5cf6, #6d28d9);
}

.logout-btn {
  margin-left: auto;
  background: transparent;
  color: #dce8ea;
  border: 1px solid rgba(255,255,255,0.08);
  padding: 7px 8px;
}

.content-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.topbar {
  height: 76px;
  background: rgba(255,255,255,0.8);
  border-bottom: 1px solid #dfe9ee;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24px;
}

.searchbox {
  display: flex;
  align-items: center;
  gap: 8px;
  background: #f5f8fa;
  border: 1px solid #dfe7eb;
  border-radius: 10px;
  padding: 0 12px;
  width: min(540px, 70%);
}

.searchbox input {
  border: 0;
  background: transparent;
  outline: none;
  width: 100%;
}

.topbar-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.top-btn {
  background: #edf3f6;
  color: #2d4954;
}

.repo-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18px;
  padding: 24px 26px 0;
}

.crumb {
  margin: 0 0 8px;
  color: #6a7d86;
  font-size: 0.76rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

.repo-header h2 {
  margin: 0;
  font-size: clamp(1.8rem, 3vw, 2.5rem);
  letter-spacing: -0.04em;
}

.repo-header p {
  margin: 8px 0 0;
  color: #536e78;
}

.repo-badges {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.pill {
  display: inline-flex;
  align-items: center;
  border-radius: 999px;
  padding: 7px 10px;
  font-size: 0.72rem;
  font-weight: 700;
}

.pill.private {
  background: #eef2f4;
  color: #415d68;
}

.pill.public {
  background: #eafaf4;
  color: #0c7b6a;
}

.pill.neutral {
  background: #f5f0ff;
  color: #6d28d9;
}

.workspace-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.5fr) 300px;
  gap: 22px;
  padding: 22px 26px 28px;
}

.chat-panel, .panel-block {
  background: white;
  border: 1px solid #dfe9ee;
  border-radius: 18px;
  overflow: hidden;
}

.chat-panel {
  display: flex;
  flex-direction: column;
  min-height: 580px;
}

.chat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18px 18px 14px;
  border-bottom: 1px solid #edf3f5;
}

.chat-header h3 {
  margin: 0;
  font-size: 1.05rem;
}

.status.online {
  color: #0d8c63;
  font-weight: 700;
  font-size: 0.8rem;
}

.message-stream {
  flex: 1;
  padding: 18px;
  display: flex;
  flex-direction: column;
  gap: 14px;
  background: linear-gradient(180deg, #fbfcfd, #f5f9fb);
}

.message-row {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  max-width: 85%;
}

.message-row.mine {
  margin-left: auto;
  flex-direction: row-reverse;
}

.bubble {
  background: white;
  border: 1px solid #dfe9ee;
  border-radius: 16px 16px 16px 4px;
  padding: 10px 12px;
  min-width: 180px;
}

.message-row.mine .bubble {
  background: #ebfbf6;
  border-color: #caefe5;
  border-radius: 16px 16px 4px 16px;
}

.bubble-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 6px;
}

.bubble-head strong {
  font-size: 0.8rem;
}

.bubble-head span {
  color: #82959d;
  font-size: 0.67rem;
}

.bubble p {
  margin: 0;
  color: #264955;
  line-height: 1.6;
  font-size: 0.9rem;
}

.typing-indicator {
  padding: 0 18px 12px;
  color: #6e7e86;
  font-size: 0.78rem;
}

.message-form {
  display: flex;
  gap: 10px;
  border-top: 1px solid #edf3f5;
  padding: 14px 18px 18px;
}

.message-form input {
  flex: 1;
}

.message-form button {
  border: 0;
  background: linear-gradient(135deg, #14b8a6, #0f7d6e);
  color: white;
  padding: 11px 16px;
  border-radius: 10px;
  font-weight: 700;
}

.side-panel {
  display: grid;
  gap: 16px;
}

.panel-block {
  padding: 18px 16px;
}

.panel-block h4 {
  margin: 0 0 14px;
}

.member-row {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 0;
}

.member-row strong, .member-row small {
  display: block;
}

.member-row small {
  color: #738c95;
  margin-top: 2px;
}

.activity-list {
  margin: 0;
  padding-left: 0;
  list-style: none;
  display: grid;
  gap: 10px;
  color: #395a66;
}

.activity-list li {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.88rem;
}

.modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(17, 39, 47, 0.58);
  display: grid;
  place-items: center;
  padding: 20px;
}

.modal-card {
  width: min(480px, 100%);
  background: white;
  border-radius: 18px;
  padding: 18px 18px 16px;
  border: 1px solid #dfe9ee;
}

.modal-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.modal-head h3 {
  margin: 0;
}

.modal-head button {
  border: 0;
  background: transparent;
  font-size: 1.1rem;
  color: #536d78;
}

.repo-form {
  display: grid;
  gap: 14px;
}

.repo-form textarea {
  min-height: 88px;
  resize: vertical;
}

.checkbox-row {
  display: flex;
  align-items: center;
  gap: 10px;
}

.checkbox-row input {
  width: auto;
}

.modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 6px;
}

.empty-state {
  display: grid;
  place-items: center;
  height: 100%;
  text-align: center;
  color: #496874;
  padding: 40px 20px;
}

@media (max-width: 1000px) {
  .dashboard-shell { flex-direction: column; }
  .sidebar { width: 100%; }
  .workspace-grid { grid-template-columns: 1fr; }
}

@media (max-width: 640px) {
  .topbar { padding: 0 14px; }
  .searchbox { width: 100%; }
  .topbar-actions { display: none; }
  .repo-header { flex-direction: column; align-items: flex-start; }
  .content-area { min-width: 0; }
}
